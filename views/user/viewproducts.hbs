<section>
  <div class="container mt-4">
    {{#each products}}
    <div class="row border-bottom py-3 align-items-center product-row">
      
      <!-- Product Image -->
      <div class="col-md-3 text-center">
        <img src="/productimages/{{this._id}}.jpg" 
             alt="{{this.Name}}" 
             class="img-fluid product-img">
      </div>

      <!-- Product Details -->
      <div class="col-md-6">
        <h5 class="mb-1 fw-semibold">{{this.Name}}</h5>

        <!-- Rating -->
        <div class="d-flex align-items-center mb-2">
          <span class="badge bg-success me-2 rating-badge">4.2 ★</span>
          <small class="text-muted">97 Ratings & 500 Reviews</small>
        </div>

        <!-- Features -->
        <ul class="mb-2 text-muted small feature-list">
          <li>{{this.RAM}} RAM | {{this.Storage}} Storage</li>
          <li>{{this.Display}}</li>
          <li>{{this.Camera}}</li>
          <li>{{this.Battery}}</li>
          <li>{{this.Processor}}</li>
        </ul>

        <small class="text-secondary">1 Year Warranty on Handset & 6 Months on Accessories</small>
      </div>

      <!-- Price & Actions -->
      <div class="col-md-3 text-end">
        <h4 class="text-dark fw-bold">₹{{this.Price}}</h4>
        <p class="mb-1">
          <span class="text-muted text-decoration-line-through">₹{{this.OldPrice}}</span>
          <span class="text-success fw-semibold"> {{this.Offer}}% off</span>
        </p>
        <p class="text-success small">Bank Offer Available</p>

        <button class="btn btn-primary btn-sm" onclick="addToCart('{{this._id}}')">Add to Cart</button>
      </div>

    </div> <!-- end row -->
    {{/each}}
  </div>
</section>

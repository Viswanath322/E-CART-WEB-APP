<div class="v-orders-page">
  <div class="v-section-header">
    <h1 class="v-section-title">My Orders</h1>
    <a href="/" class="v-btn v-btn-secondary v-btn-sm">Continue Shopping</a>
  </div>

  {{#if orders.length}}
  {{#each orders}}
  <div class="v-order-card" id="order-{{this._id}}" onclick="toggleOrder('{{this._id}}')">
    <div class="v-order-header">
      <div>
        <div style="font-weight:600; font-size:0.9rem;">Order</div>
        <div class="v-order-id">#{{this._id}}</div>
      </div>

      <div>
        <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.2rem;">Date</div>
        <div class="v-order-date">{{this.date}}</div>
      </div>

      <div>
        <span class="v-status-chip v-status-{{toLowerCase this.status}}">
          {{this.status}}
        </span>
      </div>

      <div>
        <div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.2rem;">Payment</div>
        <span class="v-status-chip v-status-{{toLowerCase this.paymentStatus}}">
          {{this.paymentStatus}}
        </span>
      </div>

      <div class="v-order-amount">₹{{this.totalAmount}}</div>

      <svg class="v-order-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>

    <div class="v-order-body">
      <div style="margin-bottom:1rem;">
        <div style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.35rem;">Delivery Address</div>
        <div style="font-size:0.875rem;">{{this.deliveryDetails.name}} • {{this.deliveryDetails.mobile}}</div>
        <div style="font-size:0.8rem; color:var(--text-muted);">{{this.deliveryDetails.address}}</div>
      </div>
      <div style="font-size:0.8rem; color:var(--text-muted); margin-bottom:0.5rem;">Items ordered: {{this.products.length}}</div>
    </div>
  </div>
  {{/each}}

  {{else}}
  <div class="v-empty-state">
    <div class="v-empty-icon">📦</div>
    <div class="v-empty-title">No orders yet</div>
    <div class="v-empty-desc">You haven't placed any orders. Start shopping now!</div>
    <a href="/" class="v-btn v-btn-primary">Shop Now</a>
  </div>
  {{/if}}
</div>

<script>
function toggleOrder(id) {
  const card = document.getElementById('order-' + id);
  card.classList.toggle('open');
}
</script>

<div class="container mt-5">
  <h2 class="text-center text-success mb-4">📦 My Orders</h2>
{{#if orders.length}}
  <table class="table table-bordered text-center">
    <thead class="table-dark">
      <tr>
        <th>Order ID</th>
        <th>Date</th>
        <th>Status</th>
        <th>Total</th>
        <th>paysta</th>
      </tr>
    </thead>
    <tbody>
      {{#each orders}}
        <tr>
          <td>{{this._id}}</td>
          <td>{{this.date}}</td>
          <td>{{this.status}}</td>
          <td>{{this.totalAmount}}</td>
          <td>{{this.paymentStatus}}</td>
          
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p class="text-center text-muted">You have no orders yet.</p>
{{/if}}

</div>

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
  <div class="success-card text-center">
    <div class="checkmark"></div>
    <h2>Order Placed!</h2>
    <p>Hi, {{user.name}} 👋</p>
    <p>Thank you for shopping with us 🎉</p>
    <p>Your order ID: <strong>{{orderId}}</strong></p>
    <p>Total Amount: <strong>₹{{total}}</strong></p>
    <a href="/view-orders" class="btn btn-success">View My Orders</a>
  </div>
</div>

<style>
  .success-card {
    background: #fff;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0px 10px 25px rgba(0,0,0,0.1);
    max-width: 400px;
    width: 100%;
    animation: popIn 0.6s ease-out;
    position: relative;
    overflow: hidden;
  }

  @keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .checkmark {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #28a745;
    margin: 0 auto 20px;
    position: relative;
    animation: scaleUp 0.5s ease forwards;
  }

  @keyframes scaleUp {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }

  .checkmark::after {
    content: '';
    position: absolute;
    left: 22px;
    top: 18px;
    width: 20px;
    height: 40px;
    border-right: 4px solid #fff;
    border-bottom: 4px solid #fff;
    transform: rotate(45deg);
  }

  .success-card h2 {
    color: #28a745;
    font-weight: bold;
    margin-bottom: 15px;
  }

  .success-card p {
    color: #555;
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .btn-success {
    margin-top: 20px;
    padding: 10px 25px;
    border-radius: 30px;
    font-weight: bold;
    box-shadow: 0 4px 10px rgba(40,167,69,0.3);
    transition: 0.3s;
  }

  .btn-success:hover {
    background-color: #218838;
    transform: translateY(-2px);
  }
</style>

<script>
  // Confetti effect
  for (let i = 0; i < 25; i++) {
    let confetti = document.createElement('div');
    confetti.classList.add('confetti');
    confetti.style.left = Math.random() * 100 + "%";
    confetti.style.background = ['#28a745', '#ffc107', '#17a2b8'][Math.floor(Math.random()*3)];
    confetti.style.animationDuration = (2 + Math.random() * 3) + "s";
    confetti.style.opacity = Math.random();
    confetti.style.transform = "rotate(" + Math.random() * 360 + "deg)";
    document.body.appendChild(confetti);
  }

  // Cleanup confetti after 5 seconds
  setTimeout(() => {
    document.querySelectorAll(".confetti").forEach(el => el.remove());
  }, 5000);

  const style = document.createElement("style");
  style.innerHTML = `
    .confetti {
      position: absolute;
      top: -10px;
      width: 10px;
      height: 10px;
      animation: fall 3s linear infinite;
    }
    @keyframes fall {
      0% { transform: translateY(0) rotate(0deg); }
      100% { transform: translateY(600px) rotate(360deg); }
    }
  `;
  document.head.appendChild(style);
</script>

<div class="v-success-page">
  <div class="v-success-anim">✓</div>
  <h1 class="v-success-title">Order Placed! 🎉</h1>
  <p class="v-success-sub">Thank you! Your order has been successfully placed and will be delivered soon.</p>

  {{#if orderId}}
  <div class="v-order-detail-card">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
      <span style="font-size:0.875rem; color:var(--text-muted);">Order ID</span>
      <span style="font-size:0.8rem; font-family:monospace; color:var(--primary-light);">{{orderId}}</span>
    </div>
    <div class="v-divider"></div>
    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:0.75rem;">
      <span style="font-size:0.875rem; color:var(--text-muted);">Total Paid</span>
      <span style="font-weight:700; font-size:1.1rem;">₹{{total}}</span>
    </div>
    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:0.75rem;">
      <span style="font-size:0.875rem; color:var(--text-muted);">Estimated Delivery</span>
      <span style="font-size:0.875rem; color:var(--success); font-weight:600;">3-5 Business Days</span>
    </div>
  </div>
  {{/if}}

  <div style="display:flex; gap:1rem; flex-wrap:wrap; justify-content:center;">
    <a href="/view-orders" class="v-btn v-btn-secondary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17H7A5 5 0 017 7h2"/><path d="M15 7h2a5 5 0 010 10h-2"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      View My Orders
    </a>
    <a href="/" class="v-btn v-btn-primary">
      Continue Shopping
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
  </div>
</div>

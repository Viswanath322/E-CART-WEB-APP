<form action="/Signup" method="post" style="width:300px; margin:auto; padding:20px; border:1px solid #ccc; border-radius:8px; background:#f9f9f9; font-family:Arial, sans-serif;">
  <h2 style="text-align:center; margin-bottom:15px;">Sign Up</h2>
  
  <label for="name" style="display:block; margin-bottom:5px;">Full Name</label>
  <input type="text" id="name" name="name" placeholder="Enter your name" required
         style="width:100%; padding:8px; margin-bottom:12px; border:1px solid #ccc; border-radius:5px;">
  
  <label for="email" style="display:block; margin-bottom:5px;">Email</label>
  <input type="email" id="email" name="Email" placeholder="Enter your email" required
         style="width:100%; padding:8px; margin-bottom:12px; border:1px solid #ccc; border-radius:5px;">
  
  <label for="Password" style="display:block; margin-bottom:5px;">Password</label>
  <input type="Password" id="Password" name="Password" placeholder="Create a password" required
         style="width:100%; padding:8px; margin-bottom:12px; border:1px solid #ccc; border-radius:5px;">
  
  <label for="confirm" style="display:block; margin-bottom:5px;">Confirm Password</label>
  <input type="Password" id="confirm" name="confirm" placeholder="Re-enter password" required
         style="width:100%; padding:8px; margin-bottom:15px; border:1px solid #ccc; border-radius:5px;">
  
  <button type="submit" 
          style="width:100%; padding:10px; background:#28a745; color:white; border:none; border-radius:5px; cursor:pointer;">
    Sign Up
  </button>
</form>

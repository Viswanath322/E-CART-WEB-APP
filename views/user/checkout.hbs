<div class="v-checkout-page">
  <h1 style="font-size:1.75rem; margin-bottom:1.5rem;">Checkout</h1>

  <!-- Step Indicator -->
  <div class="v-steps">
    <div class="v-step active" id="step-1">
      <div class="v-step-num">1</div>
      <div class="v-step-label">Delivery</div>
    </div>
    <div class="v-step-line" id="line-1"></div>
    <div class="v-step" id="step-2">
      <div class="v-step-num">2</div>
      <div class="v-step-label">Payment</div>
    </div>
    <div class="v-step-line" id="line-2"></div>
    <div class="v-step" id="step-3">
      <div class="v-step-num">3</div>
      <div class="v-step-label">Review</div>
    </div>
  </div>

  {{#if cartItems.length}}
  <div class="v-checkout-grid">
    <!-- Left: Form -->
    <div>
      <form id="checkout-form" action="/order-success" method="post">
        <!-- Step 1: Delivery -->
        <div id="step-panel-1">
          <div class="v-card" style="margin-bottom:1.5rem;">
            <div class="v-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Delivery Details
            </div>
            <div class="v-form-group">
              <label class="v-label">Full Name</label>
              <input class="v-input" type="text" name="name" placeholder="Enter your full name" required>
            </div>
            <div class="v-form-group">
              <label class="v-label">Mobile Number</label>
              <input class="v-input" type="tel" name="mobile" placeholder="+91 98765 43210" required>
            </div>
            <div class="v-form-group">
              <label class="v-label">Delivery Address</label>
              <textarea class="v-textarea" name="address" placeholder="House no., Street, Area, City, State - PIN" rows="3" required></textarea>
            </div>
            <div class="v-form-group">
              <label class="v-label">PIN Code</label>
              <input class="v-input" type="text" name="pincode" placeholder="400001" maxlength="6">
            </div>
          </div>
          <button type="button" class="v-btn v-btn-primary" onclick="goToStep(2)">
            Continue to Payment
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- Step 2: Payment -->
        <div id="step-panel-2" style="display:none;">
          <div class="v-card" style="margin-bottom:1.5rem;">
            <div class="v-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              Payment Method
            </div>
            <div class="v-payment-options">
              <label class="v-payment-option">
                <input type="radio" name="payment-method" value="COD" checked>
                <div class="v-payment-label">
                  <span class="v-payment-icon">💵</span>
                  Cash on Delivery
                </div>
              </label>
              <label class="v-payment-option">
                <input type="radio" name="payment-method" value="ONLINE">
                <div class="v-payment-label">
                  <span class="v-payment-icon">⚡</span>
                  Online Payment
                </div>
              </label>
            </div>
          </div>
          <div style="display:flex; gap:0.75rem;">
            <button type="button" class="v-btn v-btn-secondary" onclick="goToStep(1)">← Back</button>
            <button type="button" class="v-btn v-btn-primary" onclick="goToStep(3)">
              Review Order
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <!-- Step 3: Review -->
        <div id="step-panel-3" style="display:none;">
          <div class="v-card" style="margin-bottom:1.5rem;">
            <div class="v-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
              Order Review
            </div>
            {{#each cartItems}}
            <div style="display:flex; align-items:center; gap:0.75rem; padding:0.75rem 0; border-bottom:1px solid var(--border-light);">
              <img src="/productimages/{{this.item}}.jpg" style="width:50px; height:50px; object-fit:cover; border-radius:var(--radius-sm);">
              <div style="flex:1;">
                <div style="font-weight:600; font-size:0.875rem;">{{this.product.Name}}</div>
                <div style="font-size:0.8rem; color:var(--text-muted);">Qty: {{this.quantity}}</div>
              </div>
              <div style="font-weight:700;">₹{{multiply this.quantity this.product.Price}}</div>
            </div>
            {{/each}}
          </div>
          <input type="hidden" name="userId" value="{{user._id}}">
          <div style="display:flex; gap:0.75rem;">
            <button type="button" class="v-btn v-btn-secondary" onclick="goToStep(2)">← Back</button>
            <button type="submit" id="place-order-btn" class="v-btn v-btn-success" style="flex:1;">
              🎉 Place Order — ₹{{total}}
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Right: Summary -->
    <div class="v-cart-summary">
      <h3>Order Summary</h3>
      {{#each cartItems}}
      <div style="display:flex; gap:0.5rem; align-items:center; padding:0.6rem 0; border-bottom:1px solid var(--border-light);">
        <img src="/productimages/{{this.item}}.jpg" style="width:40px; height:40px; border-radius:var(--radius-sm); object-fit:cover;">
        <div style="flex:1; font-size:0.8rem;">
          <div style="font-weight:500;">{{this.product.Name}}</div>
          <div style="color:var(--text-muted);">×{{this.quantity}}</div>
        </div>
        <div style="font-weight:600; font-size:0.875rem;">₹{{multiply this.quantity this.product.Price}}</div>
      </div>
      {{/each}}
      <div class="v-summary-total" style="margin-top:0.75rem;">
        <span>Grand Total</span>
        <span>₹{{total}}</span>
      </div>
    </div>
  </div>

  {{else}}
  <div class="v-empty-state">
    <div class="v-empty-icon">🛒</div>
    <div class="v-empty-title">Cart is empty</div>
    <a href="/" class="v-btn v-btn-primary">Shop Now</a>
  </div>
  {{/if}}
</div>

<script>
function goToStep(n) {
  [1, 2, 3].forEach(i => {
    document.getElementById('step-panel-' + i).style.display = i === n ? 'block' : 'none';
    const step = document.getElementById('step-' + i);
    step.classList.remove('active', 'done');
    if (i < n) step.classList.add('done');
    if (i === n) step.classList.add('active');
    const line = document.getElementById('line-' + i);
    if (line) line.classList.toggle('done', i < n);
  });
}

// Handle online payment
document.getElementById('checkout-form')?.addEventListener('submit', function(e) {
  const payMethod = document.querySelector('[name="payment-method"]:checked')?.value;
  if (payMethod === 'ONLINE') {
    e.preventDefault();
    initiateRazorpay();
  }
});

async function initiateRazorpay() {
  const btn = document.getElementById('place-order-btn');
  btn.disabled = true;
  btn.textContent = 'Processing...';
  try {
    const formData = new FormData(document.getElementById('checkout-form'));
    const body = Object.fromEntries(formData.entries());
    const response = await fetch('/create-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await response.json();
    
    if (data.error) {
      showToast(data.error, 'error');
      setTimeout(() => window.location.href = '/cart', 2000);
      return;
    }

    const options = {
      key: data.key_id || '',
      amount: data.amount,
      currency: data.currency,
      order_id: data.id,
      name: 'V-Cart',
      description: 'Order Payment',
      handler: async function(resp) {
        const verifyRes = await fetch('/verify-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...resp, orderId: data.orderId })
        });
        const verifyData = await verifyRes.json();
        if (verifyData.status) {
          window.location.href = '/order-success';
        } else {
          showToast('Payment verification failed. Please contact support.', 'error');
        }
      },
      prefill: {
        name: document.querySelector('[name="name"]')?.value,
        contact: document.querySelector('[name="mobile"]')?.value
      },
      theme: { color: '#6C63FF' }
    };
    const rzp = new Razorpay(options);
    rzp.open();
    btn.disabled = false;
    btn.textContent = '🎉 Place Order';
  } catch (err) {
    showToast('Failed to initiate payment. Try again.', 'error');
    btn.disabled = false;
    btn.textContent = '🎉 Place Order';
  }
}
</script>

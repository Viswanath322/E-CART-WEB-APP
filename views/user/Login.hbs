<div class="v-auth-page">
  <!-- Left branding panel -->
  <div class="v-auth-left">
    <div class="v-auth-brand">V-Cart</div>
    <p class="v-auth-tagline">Your premium destination for everything you love. Shop smarter, live better.</p>
    <div style="margin-top:3rem; display:flex; gap:2rem; position:relative; z-index:1;">
      <div style="text-align:center;">
        <div style="font-size:1.6rem; font-weight:800; color:white;">10K+</div>
        <div style="font-size:0.8rem; color:rgba(255,255,255,0.65);">Products</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:1.6rem; font-weight:800; color:white;">50K+</div>
        <div style="font-size:0.8rem; color:rgba(255,255,255,0.65);">Customers</div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:1.6rem; font-weight:800; color:white;">4.9★</div>
        <div style="font-size:0.8rem; color:rgba(255,255,255,0.65);">Rating</div>
      </div>
    </div>
  </div>

  <!-- Right form panel -->
  <div class="v-auth-right">
    <div class="v-auth-card">
      <h1 class="v-auth-title">Welcome back</h1>
      <p class="v-auth-sub">Sign in to your V-Cart account</p>

      {{#if loginErr}}
      <div style="background:rgba(255,71,87,0.12); border:1px solid rgba(255,71,87,0.3); border-radius:var(--radius-md); padding:0.75rem 1rem; margin-bottom:1.25rem; color:var(--danger); font-size:0.875rem; display:flex; align-items:center; gap:0.5rem;">
        ⚠ {{loginErr}}
      </div>
      {{/if}}

      <form action="/Login" method="post" id="login-form">
        <div class="v-form-group">
          <label class="v-label" for="email">Email Address</label>
          <input class="v-input" type="email" id="email" name="Email" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div class="v-form-group">
          <label class="v-label" for="password">Password</label>
          <div class="v-input-wrap">
            <input class="v-input" type="password" id="password" name="Password" placeholder="Enter your password" required autocomplete="current-password">
            <span class="v-input-icon-right" onclick="togglePassword('password', this)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </div>
        </div>

        <button type="submit" class="v-btn v-btn-primary v-btn-block" style="margin-top:1.5rem;">
          Sign In
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </form>

      <div style="text-align:center; margin-top:1.5rem; font-size:0.875rem; color:var(--text-muted);">
        Don't have an account?
        <a href="/Signup" style="color:var(--primary-light); font-weight:600; margin-left:0.25rem;">Create one</a>
      </div>
    </div>
  </div>
</div>

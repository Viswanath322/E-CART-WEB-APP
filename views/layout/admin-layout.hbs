<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="V-Cart Admin Panel — Manage your store">
  <title>{{#if pageTitle}}{{pageTitle}} — {{/if}}Admin | V-Cart</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/main.css">
  <link rel="stylesheet" href="/stylesheets/admin.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚙️</text></svg>">
</head>
<body>

{{#if admin}}
<div class="v-admin-layout">
  <!-- Sidebar -->
  <aside class="v-sidebar" id="v-sidebar">
    <div class="v-sidebar-logo">V-Cart</div>

    <nav class="v-sidebar-nav">
      <div class="v-sidebar-section-label">Main</div>
      <a href="/admin" class="v-sidebar-link {{#if isDashboard}}active{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/admin/products" class="v-sidebar-link {{#if isProducts}}active{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        Products
      </a>
      <a href="/admin/orders" class="v-sidebar-link {{#if isOrders}}active{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17H7A5 5 0 017 7h2"/><path d="M15 7h2a5 5 0 010 10h-2"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        Orders
      </a>
      <a href="/admin/users" class="v-sidebar-link {{#if isUsers}}active{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Users
      </a>
    </nav>

    <div class="v-sidebar-footer">
      <div class="v-admin-user">
        <div class="v-admin-avatar">{{admin.Email.[0]}}</div>
        <div>
          <div class="v-admin-name">Admin</div>
          <div class="v-admin-role">{{admin.Email}}</div>
        </div>
      </div>
      <a href="/admin/logout" class="v-sidebar-link" style="margin-top:0.25rem; color: var(--danger);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </div>
  </aside>

  <!-- Main -->
  <div class="v-admin-main">
    <header class="v-admin-topbar">
      <div style="display:flex; align-items:center; gap:1rem;">
        <button id="sidebar-toggle" onclick="document.getElementById('v-sidebar').classList.toggle('open')"
          style="display:none; background:none; border:none; color:var(--text); cursor:pointer; padding:0.25rem;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <span class="v-admin-topbar-title">{{pageTitle}}</span>
      </div>
      <a href="/" target="_blank" style="font-size:0.8rem; color:var(--text-muted);">View Store →</a>
    </header>

    <div class="v-admin-content v-page-enter">
      {{{body}}}
    </div>
  </div>
</div>
{{else}}
  {{{body}}}
{{/if}}

  <!-- Toast container -->
  <div class="v-toast-container" id="toast-container"></div>

  <script src="/javascripts/script.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</body>
</html>

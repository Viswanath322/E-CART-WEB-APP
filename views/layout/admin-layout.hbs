<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
    }

    .navbar {
      box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
    }

    .content {
      padding: 20px;
      min-height: 90vh;
    }

    footer {
      background: #212529;
      color: #ddd;
      padding: 15px 0;
      text-align: center;
      margin-top: 20px;
    }
  </style>
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/admin">E-Admin</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        {{!-- <li class="nav-item"><a class="nav-link" href="/admin">Dashboard</a></li> --}}
          <li class="nav-item"><a class="nav-link" href="/admin">Products</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/addproducts">Add Product</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/orders">Orders</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/users">Users</a></li>
        </ul>


        <!-- Logout -->
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link text-danger fw-bold" href="/admin/logout">Logout</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Page content -->
  <main class="content container">
    {{{body}}}
  </main>

  <!-- Footer -->
  <footer>
    <p class="mb-0">© 2025 E-Admin Panel | Powered by Node.js & MongoDB</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

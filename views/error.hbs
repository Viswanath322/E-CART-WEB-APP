<div style="min-height:70vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:3rem 1.5rem;">
  <div style="font-size:4rem; margin-bottom:1rem;">😕</div>
  <h1 style="font-size:2rem; margin-bottom:0.5rem;">{{message}}</h1>
  <p style="color:var(--text-muted); margin-bottom:2rem;">
    {{#if error.status}}Error {{error.status}}{{else}}Something went wrong{{/if}}
  </p>
  <a href="/" class="v-btn v-btn-primary">← Go Back Home</a>
</div>

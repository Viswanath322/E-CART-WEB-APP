<!-- Products Table Section -->
<section>
 <div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-1">Products List</h2>
    <a href="/admin/addproducts" class="btn btn-success">add product</a>
  </div>
</div>

    
    <div class="table-responsive container">
      <table class="table table-striped table-hover align-middle  table-primary ">
        <thead class="table-dark">
          <tr>
            <th scope="col">NO</th>
            <th scope="col">Image</th>
            <th scope="col">Product Name</th>
            <th scope="col">Price</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr>
            <th scope="row">{{inc @index}}</th>
            <td>
              <img src="/productimages/{{this._id}}.jpg" alt="{{this.name}}" class="img-thumbnail " style="width: 50px; height: auto;">
            </td>
            <td>{{this.Name}}</td>
            <td>₹{{this.Price}}</td> 
            <td>
              <a href="/admin/editproduct/{{this._id}}" class="btn btn-sm btn-primary">EDIT</a>
              <a href="/admin/deleteproduct/{{this._id}}  " class="btn btn-sm btn-danger " onclick="return confirm('are you sure u want to delete {{this.Name}} ?')">DELETE</a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>

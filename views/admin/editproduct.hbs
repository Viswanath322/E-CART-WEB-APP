<div class="container mt-4">
  <div class="row">
    <div class="col-md-6">
      <h2 class="text-center">editproduct</h2>
      <form action="/admin/editproduct/{{product._id}}" enctype="multipart/form-data" method="post" >
        <label for="">Name</label>
        <input type="text" name="Name" class="form-control" value="{{product.Name}}">

        <label for="">Category</label>
        <input type="text" name="Category" class="form-control" value="{{product.Category}}">

        <label for="">Price</label>
        <input type="text" name="Price" class="form-control" value="{{product.Price}}">

        <label for="">Description</label>
        <input type="text" name="Description" class="form-control" value="{{product.Description}}">

        <label for="">Image</label>
        <img src="/productimages/{{product._id}}.jpg" alt="" style="width: 120px; height:auto" id="imgview">
        <input type="file"  name="image"  class="form-control" onchange="viewpic(event)">

        <button type="submit" class="btn btn-success mt-4">Submit</button>
      </form>
    </div>
  </div>
</div>


<script>
  function viewpic(event){
   document.getElementById('imgview').src=URL.createObjectURL(event.target.files[0])
  }
</script>

<div class="v-admin-login">
  <div class="v-admin-login-card">
    <div class="v-admin-login-icon">⚙️</div>
    <h1 style="text-align:center; font-size:1.5rem; margin-bottom:0.25rem;">Admin Login</h1>
    <p style="text-align:center; color:var(--text-muted); font-size:0.875rem; margin-bottom:1.75rem;">
      V-Cart Admin Panel
    </p>

    {{#if loginErr}}
    <div style="background:rgba(255,71,87,0.12); border:1px solid rgba(255,71,87,0.3); border-radius:var(--radius-md); padding:0.75rem 1rem; margin-bottom:1.25rem; color:var(--danger); font-size:0.875rem;">
      ⚠ {{loginErr}}
    </div>
    {{/if}}

    <form action="/admin/Login" method="post">
      <div class="v-form-group">
        <label class="v-label">Email Address</label>
        <input class="v-input" type="email" name="Email" placeholder="admin@vcart.com" required autocomplete="email">
      </div>
      <div class="v-form-group">
        <label class="v-label">Password</label>
        <div class="v-input-wrap">
          <input class="v-input" type="password" id="admin-password" name="Password" placeholder="Admin password" required>
          <span class="v-input-icon-right" onclick="togglePassword('admin-password', this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </span>
        </div>
      </div>

      <button type="submit" class="v-btn v-btn-primary v-btn-block" style="margin-top:1.5rem;">
        Sign In to Admin
      </button>
    </form>
  </div>
</div>
